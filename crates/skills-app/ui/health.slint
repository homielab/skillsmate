import { Button, Palette, ScrollView, Spinner } from "std-widgets.slint";
import { Theme, Card, Section, StatTile, PageHeader, StatusMark } from "components.slint";
import { FindingRow, UpdateRow } from "types.slint";

component FindingItem inherits Rectangle {
    in property <FindingRow> finding;
    callback open-skill(string);
    callback fix(int);

    height: content.preferred-height;
    content := HorizontalLayout {
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 12px;
        StatusMark { kind: finding.kind; y: 9px; }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: finding.title;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                if finding.skill != "": Rectangle {
                    width: skill-label.preferred-width + 12px;
                    height: 20px;
                    border-radius: 10px;
                    background: skill-touch.has-hover ? Theme.hover-fill : Theme.subtle-fill;
                    skill-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-skill(finding.key); }
                    }
                    skill-label := Text {
                        text: finding.skill + " ›";
                        font-size: 11px;
                        color: Theme.text;
                    }
                }
            }
            Text {
                text: finding.detail;
                color: Theme.muted;
                wrap: word-wrap;
            }
        }
        if finding.fix-label != "": VerticalLayout {
            alignment: center;
            Button {
                text: finding.fix-label;
                clicked => { root.fix(finding.index); }
            }
        }
    }
}

export component HealthPage inherits ScrollView {
    in property <string> summary;
    in property <string> problems;
    in property <string> warnings;
    in property <string> tips;
    in property <string> startup;
    in property <string> startup-note;
    in property <[FindingRow]> findings;
    in property <[UpdateRow]> updates;
    in property <bool> checking;
    in property <string> updates-status;
    in property <bool> loading;
    callback refresh();
    callback check-updates();
    callback update-skill(string);
    callback update-all();
    callback open-skill(string);
    callback fix(int);
    in property <int> broken-links;
    callback fix-all-links();

    property <int> updatable: 0;

    VerticalLayout {
        padding: Theme.page-padding;
        alignment: start;
        spacing: Theme.gap + 4px;

        PageHeader {
            title: "Health";
            subtitle: root.summary;
            if root.loading || root.checking: Spinner { indeterminate: true; width: 20px; height: 20px; }
            Button {
                text: "Refresh";
                enabled: !root.loading;
                clicked => { root.refresh(); }
            }
        }

        HorizontalLayout {
            spacing: Theme.gap;
            StatTile { label: "Problems"; value: root.problems; note: "Broken or not loading"; }
            StatTile { label: "Warnings"; value: root.warnings; note: "Working, but not as intended"; }
            StatTile { label: "Tips"; value: root.tips; note: "Ways to improve"; }
            StatTile { label: "Loaded every session"; value: root.startup; note: root.startup-note; }
        }

        Section {
            title: "Updates";
            note: root.updates-status;
            if root.updates.length == 0: HorizontalLayout {
                spacing: 12px;
                Text {
                    text: "Compares your installed skills with the versions published on skills.sh, file by file. Sends the names of your skills.sh skills to skills.sh.";
                    color: Theme.muted;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: root.checking ? "Checking…" : "Check for updates";
                        enabled: !root.checking;
                        primary: true;
                        clicked => { root.check-updates(); }
                    }
                }
            }
            for row in root.updates: HorizontalLayout {
                spacing: 12px;
                padding-top: 4px;
                padding-bottom: 4px;
                StatusMark { kind: row.kind; y: (parent.height - self.height) / 2; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: row.name; font-weight: 600; color: Theme.text; overflow: elide; }
                        Text { text: row.label; color: Theme.text; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text { text: row.source + (row.summary != "" ? "  ·  " + row.summary : ""); color: Theme.muted; font-size: 12px; overflow: elide; }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "What changed";
                        clicked => { root.open-skill(row.key); }
                    }
                }
                if row.can-update: VerticalLayout {
                    alignment: center;
                    Button {
                        text: "Update";
                        primary: true;
                        clicked => { root.update-skill(row.key); }
                    }
                }
            }
            if root.updates.length > 0: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button {
                    text: "Check again";
                    enabled: !root.checking;
                    clicked => { root.check-updates(); }
                }
            }
        }

        Section {
            title: "Findings";
            note: root.findings.length == 0 ? "" : root.findings.length + " total";
            if root.broken-links > 1: Rectangle {
                height: bulk.preferred-height;
                border-radius: 8px;
                background: Theme.subtle-fill;
                bulk := HorizontalLayout {
                    padding: 10px;
                    padding-left: 12px;
                    spacing: 12px;
                    Text {
                        text: root.broken-links + " links point to skills that no longer exist.";
                        color: Theme.text;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "Remove all " + root.broken-links;
                            clicked => { root.fix-all-links(); }
                        }
                    }
                }
            }
            if root.findings.length == 0 && !root.loading: Text {
                text: "Nothing to report. Your skills follow the Agent Skills spec and every agent can see them.";
                color: Theme.muted;
                wrap: word-wrap;
            }
            for row[i] in root.findings: VerticalLayout {
                if i > 0: Rectangle { height: 1px; background: Theme.card-border; }
                FindingItem {
                    finding: row;
                    open-skill(key) => { root.open-skill(key); }
                    fix(index) => { root.fix(index); }
                }
            }
        }
    }
}
