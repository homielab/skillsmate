import { Button, Palette, Spinner } from "std-widgets.slint";
import { Theme, Card } from "components.slint";

/// Modal confirmation. Covers the window with a scrim; Escape or a click on
/// the scrim cancels.
export component ConfirmDialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> confirm-label;
    in property <bool> destructive;
    callback accepted();
    callback dismissed();

    background: #00000066;
    // Swallow clicks so nothing underneath reacts.
    TouchArea {
        clicked => { root.dismissed(); }
    }
    FocusScope {
        key-pressed(e) => {
            // Escape cancels. Enter deliberately doesn't confirm: several of
            // these actions remove things.
            if e.text == Key.Escape { root.dismissed(); return accept; }
            reject
        }
        init => { self.focus(); }
    }

    Card {
        width: min(460px, parent.width - 48px);
        height: inner.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.card;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        // Clicks inside the card don't dismiss.
        TouchArea {}
        inner := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text {
                text: root.title;
                font-size: 16px;
                font-weight: 700;
                color: Palette.foreground;
                wrap: word-wrap;
            }
            Text {
                text: root.message;
                color: Theme.body;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button {
                    text: "Cancel";
                    clicked => { root.dismissed(); }
                }
                Button {
                    text: root.confirm-label;
                    primary: !root.destructive;
                    clicked => { root.accepted(); }
                }
            }
        }
    }
}

/// Bottom notification: progress, result with Undo, or an error.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <bool> busy;
    in property <bool> can-undo;
    in property <bool> error;
    callback undo();
    callback dismissed();

    height: row.preferred-height;
    border-radius: 10px;
    background: Palette.foreground;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000033;
    row := HorizontalLayout {
        padding: 10px;
        padding-left: 16px;
        spacing: 12px;
        if root.busy: Spinner { indeterminate: true; width: 16px; height: 16px; y: (parent.height - self.height) / 2; }
        if root.error: Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: #d03b3b;
            y: (parent.height - self.height) / 2;
            Text { text: "!"; color: #ffffff; font-size: 11px; font-weight: 800; }
        }
        Text {
            text: root.text;
            color: Palette.background;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        if root.can-undo: Rectangle {
            width: undo-label.preferred-width + 20px;
            border-radius: 6px;
            background: undo-touch.has-hover ? Palette.background.with-alpha(0.2) : Palette.background.with-alpha(0.1);
            undo-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.undo(); }
            }
            undo-label := Text {
                text: "Undo";
                font-weight: 700;
                color: Palette.background;
            }
        }
        if !root.busy: Rectangle {
            width: 28px;
            border-radius: 6px;
            background: close-touch.has-hover ? Palette.background.with-alpha(0.15) : transparent;
            close-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.dismissed(); }
            }
            Text { text: "×"; font-size: 16px; color: Palette.background; }
        }
    }
}
