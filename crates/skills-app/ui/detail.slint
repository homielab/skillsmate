import { Button, Palette, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme, Card, Section, StatTile, StatusMark, Pill } from "components.slint";
import { Detail, FindingRow, MdBlock, DiffRow } from "types.slint";

component DiffView inherits VerticalLayout {
    in property <[DiffRow]> rows;
    spacing: 0px;
    for row in root.rows: Rectangle {
        height: line.preferred-height + (row.kind == 0 ? 10px : 2px);
        background: row.kind == 1 ? #0ca30c26 : row.kind == 2 ? #d03b3b26 : transparent;
        border-radius: 3px;
        line := Text {
            x: 8px;
            width: parent.width - 16px;
            y: row.kind == 0 ? 8px : 1px;
            text: (row.kind == 1 ? "+ " : row.kind == 2 ? "− " : row.kind == 3 ? "  " : "") + row.text;
            font-family: "monospace";
            font-size: 12px;
            font-weight: row.kind == 0 ? 700 : 400;
            color: row.kind == 4 ? Theme.muted : Theme.text;
            wrap: word-wrap;
        }
    }
}

component MarkdownView inherits VerticalLayout {
    in property <[MdBlock]> blocks;
    spacing: 8px;
    for b in root.blocks: Rectangle {
        height: t.preferred-height + (b.kind == 5 ? 16px : 0px) + (b.kind <= 2 ? 6px : 0px);
        background: b.kind == 5 ? Theme.subtle-fill : transparent;
        border-radius: 6px;
        if b.kind == 6: Rectangle {
            x: 0;
            width: 3px;
            background: Theme.card-border;
        }
        if b.kind == 4: Text {
            x: b.depth * 16px;
            y: 0;
            text: "•";
            color: Theme.muted;
        }
        t := Text {
            x: b.kind == 4 ? b.depth * 16px + 14px : b.kind == 5 ? 10px : b.kind == 6 ? 12px : 0px;
            y: b.kind == 5 ? 8px : b.kind <= 2 ? 6px : 0px;
            width: parent.width - self.x - (b.kind == 5 ? 10px : 0px);
            text: b.text;
            wrap: word-wrap;
            color: b.kind == 6 ? Theme.muted : Theme.text;
            font-size: b.kind == 0 ? 20px : b.kind == 1 ? 17px : b.kind == 2 ? 15px : b.kind == 5 ? 12px : 14px;
            font-weight: b.kind <= 2 ? 700 : 400;
            font-family: b.kind == 5 ? "monospace" : "";
        }
    }
}

component KeyValue inherits HorizontalLayout {
    in property <string> key;
    in property <string> value;
    spacing: 12px;
    Text { text: root.key; color: Theme.muted; min-width: 120px; }
    Text { text: root.value; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; }
}

export component DetailPage inherits ScrollView {
    in property <Detail> d;
    in property <bool> checking;
    in property <bool> editing;
    in-out property <string> edit-text;
    in property <string> edit-error;
    callback edit();
    callback save-edit(string);
    callback cancel-edit();
    callback back();
    callback update();
    callback check();
    callback remove();
    callback open-url(string);
    callback open-skill(string);
    callback fix(int);

    VerticalLayout {
        padding: Theme.page-padding;
        alignment: start;
        spacing: Theme.gap + 4px;

        HorizontalLayout {
            alignment: start;
            Button { text: "‹ Back"; clicked => { root.back(); } }
        }
        HorizontalLayout {
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.d.name; font-size: 26px; font-weight: 700; color: Theme.text; overflow: elide; }
                    if root.d.version != "": Pill { text: "v" + root.d.version; y: (parent.height - self.height) / 2; }
                    Pill { text: root.d.source; y: (parent.height - self.height) / 2; }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text { text: root.d.description; color: Theme.body; wrap: word-wrap; }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if root.d.can-update: Button {
                text: "Update";
                primary: true;
                clicked => { root.update(); }
            }
            if root.d.managed: Button {
                text: root.checking ? "Checking…" : "Check for updates";
                enabled: !root.checking;
                clicked => { root.check(); }
            }
            if !root.editing: Button {
                text: "Edit SKILL.md";
                clicked => { root.edit(); }
            }
            if root.d.url != "": Button {
                text: "View on skills.sh";
                clicked => { root.open-url(root.d.url); }
            }
            Button {
                text: "Remove…";
                clicked => { root.remove(); }
            }
        }

        HorizontalLayout {
            spacing: Theme.gap;
            StatTile { label: "Size"; value: root.d.size; note: root.d.files-count; }
            StatTile { label: "When active"; value: root.d.active-tokens; note: "SKILL.md, loaded on use"; }
            StatTile { label: "Every session"; value: root.d.startup-tokens; note: "Name and description"; }
            StatTile { label: "Version"; value: root.d.update-label; note: root.d.update-summary; }
        }

        if root.editing: Section {
            title: "Edit SKILL.md";
            note: "Your current version is backed up when you save";
            TextEdit {
                height: 460px;
                text <=> root.edit-text;
                wrap: word-wrap;
                font-size: 13px;
            }
            if root.edit-error != "": HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: #d03b3b;
                    Text { text: "!"; color: #ffffff; font-size: 11px; font-weight: 800; }
                }
                Text { text: root.edit-error; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button { text: "Cancel"; clicked => { root.cancel-edit(); } }
                Button { text: "Save"; primary: true; clicked => { root.save-edit(root.edit-text); } }
            }
        }

        if root.d.diff.length > 0: Section {
            title: "What changed on skills.sh";
            note: root.d.update-summary;
            DiffView { rows: root.d.diff; }
        }

        HorizontalLayout {
            spacing: Theme.gap;
            alignment: stretch;
            Section {
                horizontal-stretch: 1;
                preferred-width: 1px;
                title: "Used by";
                if root.d.agents.length == 0: Text { text: "No detected agent can see this skill."; color: Theme.muted; wrap: word-wrap; }
                for a in root.d.agents: HorizontalLayout {
                    Text { text: a.name; color: Theme.text; horizontal-stretch: 1; }
                    Text { text: a.how; color: Theme.muted; font-size: 12px; }
                }
            }
            Section {
                horizontal-stretch: 1;
                preferred-width: 1px;
                title: "Details";
                KeyValue { key: "Location"; value: root.d.location; }
                if root.d.license != "": KeyValue { key: "License"; value: root.d.license; }
                if root.d.compatibility != "": KeyValue { key: "Requires"; value: root.d.compatibility; }
                if root.d.allowed-tools != "": KeyValue { key: "Pre-approved tools"; value: root.d.allowed-tools; }
            }
        }

        if root.d.findings.length > 0: Section {
            title: "Health";
            for f in root.d.findings: HorizontalLayout {
                spacing: 12px;
                StatusMark { kind: f.kind; y: 2px; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text { text: f.title; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                    Text { text: f.detail; color: Theme.body; wrap: word-wrap; }
                }
                if f.fix-label != "": VerticalLayout {
                    alignment: center;
                    Button { text: f.fix-label; clicked => { root.fix(f.index); } }
                }
            }
        }

        if !root.editing: Section {
            title: "SKILL.md";
            MarkdownView { blocks: root.d.body; }
            if root.d.body.length == 0: Text { text: "No instructions."; color: Theme.muted; }
        }

        Section {
            title: "Files";
            note: root.d.files-count;
            for f in root.d.files: HorizontalLayout {
                Text { text: f.path; color: Theme.text; font-family: "monospace"; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
                Text { text: f.size; color: Theme.muted; font-size: 12px; }
            }
        }
    }
}
