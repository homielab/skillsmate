// Data structures shared by the Health, Detail and overlay views.

export struct FindingRow {
    title: string,
    detail: string,
    // Display name of the skill it's about, "" for general findings.
    skill: string,
    // Frontmatter name, used to open the skill.
    key: string,
    // StatusMark kind: 2 problem, 1 warning, 4 tip
    kind: int,
    // Button label for a one-click fix, "" when there's none.
    fix-label: string,
    index: int,
}

export struct UpdateRow {
    name: string,
    key: string,
    source: string,
    label: string,
    // StatusMark kind
    kind: int,
    summary: string,
    can-update: bool,
}

export struct AgentUse {
    name: string,
    how: string,
}

export struct DiffRow {
    // 0 file header, 1 added, 2 removed, 3 context, 4 note
    kind: int,
    text: string,
}

export struct MdBlock {
    // 0 h1, 1 h2, 2 h3, 3 paragraph, 4 bullet, 5 code, 6 quote
    kind: int,
    text: string,
    depth: int,
}

export struct FileRow {
    path: string,
    size: string,
}

export struct Detail {
    key: string,
    name: string,
    description: string,
    version: string,
    source: string,
    managed: bool,
    location: string,
    size: string,
    files-count: string,
    active-tokens: string,
    startup-tokens: string,
    update-label: string,
    update-kind: int,
    update-summary: string,
    can-update: bool,
    url: string,
    license: string,
    compatibility: string,
    allowed-tools: string,
    agents: [AgentUse],
    findings: [FindingRow],
    diff: [DiffRow],
    body: [MdBlock],
    files: [FileRow],
}

export struct RecRow {
    name: string,
    source: string,
    slug: string,
    reason: string,
    url: string,
}
